# Local OTA settings for the kc868a16_ota environment.
# Copy this file to .env, fill in the real values, and never commit .env.
# PROMETHEY_OTA_AUTH is injected into the firmware at build time for the
# kc868a16_ota env, so it always matches the ArduinoOTA password.
# PROMETHEY_OTA_AUTH must not contain double-quote or backslash characters.
PROMETHEY_OTA_IP=192.168.1.45
PROMETHEY_OTA_AUTH=change-me
